# Google Maps JavaScript API Key (with Photorealistic 3D Maps enabled)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY


# Server only: never prefix the AeroAPI key with VITE_
AEROAPI_KEY=YOUR_FLIGHTAWARE_AEROAPI_KEY
SKYROUTE_DATA_MODE=mock
AEROAPI_MAX_CALLS_PER_MINUTE=20
PORT=8787

# Server only: Gemini flight commentary
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
